# ── Database (Neon hosted Postgres) ────────────────────────────────
# Paste your Neon pooled connection string here. Must include sslmode=require.
# Copy this file to .env and fill in real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Booking / business rules ───────────────────────────────────────
DAILY_CAPACITY="4"          # cars per working day
DEPOSIT_PERCENT="10"        # % of total taken to lock a slot

# ── Notifications (WhatsApp + owner ping) ──────────────────────────
OWNER_WHATSAPP="+20XXXXXXXXXX"
WHATSAPP_API_TOKEN=""       # fill when wiring provider in step 5
WHATSAPP_PHONE_ID=""

# ── Payments (filled in step 3) ────────────────────────────────────
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
KASHIER_MERCHANT_ID=""
KASHIER_API_KEY=""
